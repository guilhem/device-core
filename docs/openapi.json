    "/v1/events": {
      "get": {
        "summary": "SSE notifications from the same domain event stream as D-Bus",
        "description": "Initial snapshot, then network/audio/config/system/voice/updates/maintenance events. A resync event means re-read snapshots. No replay guarantee across daemon incarnations.",
        "responses": {
          "200": {
            "description": "Event stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
